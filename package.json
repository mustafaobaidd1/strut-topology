{
  "name": "strut-topology",
  "private": true,
  "version": "1.0.0",
  "description": "Place supports and loads, and watch finite-element topology optimization grow the stiffest structure for the material you allow.",
  "type": "module",
  "license": "MIT",
  "author": "Mustafa Obaid",
  "homepage": "https://mustafaobaidd1.github.io/strut-topology/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mustafaobaidd1/strut-topology.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run build && npm run test:e2e",
    "validate": "vitest run --config vitest.validate.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "earcut": "^3.2.4",
    "katex": "^0.19.0"
  }
}
